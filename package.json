{
  "name": "ship-fast-code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8085",
    "serve": "node scripts/serve.js",
    "build": "next build",
    "postbuild": "next-sitemap",
    "postinstall": "npx playwright install chromium --with-deps || true",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "engine:dev": "tsx watch services/interview-engine/index.js",
    "engine:start": "tsx services/interview-engine/index.js",
    "worker:hiring": "tsx workers/hiring-worker.js",
    "poster:engine": "tsx services/poster-engine/index.js",
    "check:branding": "bash scripts/check-branding.sh",
    "sync:mediapipe": "node scripts/sync-mediapipe.js",
    "test:hiring": "tsx --test tests/hiring/*.test.js",
    "test:sales": "tsx --test tests/sales/*.test.js",
    "test:sales:campaigns": "tsx --test tests/sales/1-campaigns.test.js",
    "test:sales:find-leads": "tsx --test tests/sales/2-find-leads.test.js",
    "test:sales:research": "tsx --test tests/sales/3-research.test.js",
    "test:sales:messages": "tsx --test tests/sales/4-messages.test.js",
    "test:sales:outreach": "tsx --test tests/sales/5-outreach.test.js",
    "test:sales:conversations": "tsx --test tests/sales/6-conversations.test.js",
    "test:sales:meetings": "tsx --test tests/sales/7-meetings.test.js",
    "test:sales:results": "tsx --test tests/sales/8-results.test.js",
    "test:sales:knowledge": "tsx --test tests/sales/knowledge-base.test.js",
    "test:sales:agent": "tsx --test tests/sales/sales-agent.test.js",
    "test:sales:live": "RUN_LIVE_TESTS=1 tsx --test tests/sales/live-services.test.js",
    "setup:indeed": "python3 -m venv services/indeed-search/.venv && services/indeed-search/.venv/bin/pip install -r services/indeed-search/requirements.txt"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@deepgram/sdk": "^5.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^1.7.18",
    "@huggingface/transformers": "^4.3.1",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-devtools": "^5.87.4",
    "@types/pg": "^8.15.5",
    "apify-client": "^2.17.0",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.2",
    "crisp-sdk-web": "^1.0.22",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.5",
    "eslint": "8.47.0",
    "eslint-config-next": "13.4.19",
    "form-data": "^4.0.0",
    "groq-sdk": "^0.32.0",
    "imapflow": "^2.2.6",
    "ioredis": "^5.7.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.544.0",
    "mailgun.js": "^9.4.1",
    "mailparser": "^3.9.36",
    "mammoth": "^1.11.0",
    "nanoid": "^5.1.6",
    "next": "^14.1.4",
    "next-auth": "^4.24.7",
    "next-sitemap": "^4.2.3",
    "nextjs-toploader": "^1.6.11",
    "nodemailer": "^6.9.13",
    "openai": "^5.20.2",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.55.0",
    "postgres": "^3.4.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-tooltip": "^5.26.3",
    "reactflow": "^11.11.4",
    "redis": "^5.8.3",
    "sharp": "^0.34.4",
    "stripe": "^13.11.0",
    "tsx": "^4.20.6",
    "uuid": "^13.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "daisyui": "^4.10.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
