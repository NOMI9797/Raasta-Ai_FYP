# Copy to .env.local and fill in values. See docs/ai-hiring/15-env-deployment.md.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ─── Database / cache ───
DATABASE_URL=
DATABASE_SSL=
REDIS_URL=

# ─── LLM (Groq) ───
GROQ_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_BASE_URL=

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_INTERVIEW_WS_URL=

# ─── Interview engine ───
INTERVIEW_TICKET_SECRET=
INTERVIEW_ENGINE_PORT=
INTERVIEW_MAX_SESSIONS=
INTERVIEW_SILENCE_MS=
INTERVIEWER_NAME=
TTS_VOICE=
DEEPGRAM_API_KEY=
LOG_LEVEL=

# ─── AI engine (Python) ───
AI_ENGINE_URL=
AI_ENGINE_TOKEN=
MODEL_CACHE_DIR=
FACE_ANALYSIS_ENABLED=

# ─── Storage (resumes, recordings) ───
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Hiring worker ───
HIRING_WORKER_CONCURRENCY=
WORKER_ID=

# ─── Email ───
MAILGUN_API_KEY=
# Without MAILGUN_API_KEY (outside production) emails are written to STORAGE_LOCAL_DIR/outbox instead.
# EMAIL_OUTBOX=local keeps that behaviour in production too (npm run serve sets it).
EMAIL_OUTBOX=

# ─── Speed (see docs/ai-hiring/21-performance.md) ───
# DEV_WARMUP=false turns off the screen warm-up that runs after npm run dev starts
DEV_WARMUP=
# QUERY_DEVTOOLS=true shows the React Query panel in npm run dev
QUERY_DEVTOOLS=
EMAIL_TIMEZONE=

# ─── Sales: Indeed lead search (JobSpy, free; set up with npm run setup:indeed) ───
# Python that has python-jobspy installed (default: services/indeed-search/.venv)
INDEED_SEARCH_PYTHON=
# Default Indeed country when the Lead Scraper doesn't send one (default: pk)
INDEED_JOBS_COUNTRY=

# ─── Sales email (Gmail or any SMTP server; without these, emails go to the local outbox) ───
SMTP_SERVER=
SMTP_PORT=
SENDER_EMAIL=
SENDER_PASSWORD=
# While testing, send every sales email to this address instead of the real recipient
SALES_EMAIL_TEST_RECIPIENT=

# Sales replies: the worker reads the SENDER_EMAIL mailbox over IMAP every 2 minutes (same app
# password as SMTP; Gmail needs IMAP enabled). Only replies to sales emails are kept.
# IMAP_SERVER=imap.gmail.com          # default: SMTP_SERVER with smtp. → imap.
# IMAP_PORT=993
# SALES_INBOX_SYNC=off                # turn reading replies off
# SALES_INBOX_INTERVAL_SECONDS=120
# Knowledge base embeddings run locally (model downloads once to .cache/models)
# KB_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# KB_MODEL_CACHE=/path/to/models
