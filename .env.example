# Copy to .env.local and fill in values. See docs/ai-hiring/15-env-deployment.md.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ─── Database / cache ───
DATABASE_URL=
DATABASE_SSL=
REDIS_URL=

# ─── LLM (Groq) ───
GROQ_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_BASE_URL=

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_INTERVIEW_WS_URL=

# ─── Interview engine ───
INTERVIEW_TICKET_SECRET=
INTERVIEW_ENGINE_PORT=
INTERVIEW_MAX_SESSIONS=
INTERVIEW_SILENCE_MS=
INTERVIEWER_NAME=
TTS_VOICE=
DEEPGRAM_API_KEY=
# Interview language (default en). Locks speech recognition to it; auto lets Whisper guess
STT_LANGUAGE=
# low | medium | high: default reasoning effort for openai/gpt-oss models (the interview paths use low)
LLM_REASONING_EFFORT=
LOG_LEVEL=

# ─── AI engine (Python) ───
AI_ENGINE_URL=
AI_ENGINE_TOKEN=
MODEL_CACHE_DIR=
FACE_ANALYSIS_ENABLED=

# ─── Storage (resumes, recordings) ───
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Hiring worker ───
HIRING_WORKER_CONCURRENCY=
WORKER_ID=
# Where ffmpeg is when it isn't on PATH. The worker joins and decodes interview recordings with it
FFMPEG_PATH=

# ─── Email (Mailgun; interview invites, reminders, outcome emails) ───
# Both are needed to send. Run `npm run mail:check` to verify them (add an address to send a test email).
MAILGUN_API_KEY=
# The sending domain exactly as the Mailgun dashboard lists it (mg.example.com, or sandbox….mailgun.org)
MAILGUN_DOMAIN=
# "eu" if the domain was created in Mailgun's EU region (default us). MAILGUN_API_URL overrides both.
MAILGUN_REGION=
MAILGUN_API_URL=
# Optional. Default sender is "Raasta-AI <noreply@MAILGUN_DOMAIN>"; set it to use another address on that domain
MAILGUN_FROM=
MAILGUN_REPLY_TO=
# A sandbox domain only delivers to its authorized recipients (add them in the Mailgun dashboard first).
# Without MAILGUN_API_KEY (outside production) emails are written to STORAGE_LOCAL_DIR/outbox instead.
# EMAIL_OUTBOX=local keeps that behaviour in production too (npm run serve sets it).
EMAIL_OUTBOX=

# ─── Speed (see docs/ai-hiring/21-performance.md) ───
# DEV_WARMUP=false turns off the screen warm-up that runs after npm run dev starts
DEV_WARMUP=
# QUERY_DEVTOOLS=true shows the React Query panel in npm run dev
QUERY_DEVTOOLS=
EMAIL_TIMEZONE=

# ─── Job publishing (see docs/ai-hiring/19-platform-publishing.md) ───
# Automatic posts per account per 24 hours, and minutes between two. <PLATFORM> = LINKEDIN | ROZEE | INDEED
PUBLISH_DAILY_CAP_INDEED=
PUBLISH_MIN_GAP_MINUTES_INDEED=
# INDEED_DEBUG=true records every automatic Indeed post attempt in debug-indeed/ (screenshots, page structure, errors)
INDEED_DEBUG=
INDEED_DEBUG_DIR=
# Minutes the Indeed sign-in window waits for you (1-30); INDEED_CONNECT_WINDOW=off on a server without a screen
INDEED_CONNECT_WAIT_MINUTES=
INDEED_CONNECT_WINDOW=
# Seconds the Indeed diagnostic waits (window shown) for you to clear a verification check; 10-600
INDEED_CHECK_WAIT_SECONDS=
# Posting to Indeed in the background (a saved session, nobody watching) is not built: Indeed's bot check blocks a hidden browser
# (docs/ai-hiring/19, sections 5b and 5c). Use the posting engine below, or Copy and open. INDEED_AUTO_POST=true only unlocks the empty path
INDEED_AUTO_POST=
# The posting engine (docs/ai-hiring/19, section 5f): runs on the recruiter's own machine (npm run poster:engine, or Start in the Publish panel)
# Port of its health address on this machine (default 8095)
POSTER_ENGINE_PORT=
# Typing speed in the window: natural (default), fast or off
POSTER_TYPING_SPEED=
# Which browser it opens: chrome (default, falls back to Chromium), msedge or chromium
POSTER_BROWSER=
# true adds stealth launch flags. Off by default: try a visible window with a person and human-like typing first (CLAUDE.md conventions)
POSTER_STEALTH=
# Hours the engine leaves a person's Indeed alone after Indeed pauses the account (default 24)
POSTER_PAUSED_COOLOFF_HOURS=
# Where per-step screenshots go (default .runtime/poster-runs)
POSTER_SHOTS_DIR=

# ─── Sales: Indeed lead search (JobSpy, free; set up with npm run setup:indeed) ───
# Python that has python-jobspy installed (default: services/indeed-search/.venv)
INDEED_SEARCH_PYTHON=
# Default Indeed country when the Lead Scraper doesn't send one (default: pk)
INDEED_JOBS_COUNTRY=

# ─── Sales email (Gmail or any SMTP server; without these, emails go to the local outbox) ───
SMTP_SERVER=
SMTP_PORT=
SENDER_EMAIL=
SENDER_PASSWORD=
# While testing, send every sales email to this address instead of the real recipient
SALES_EMAIL_TEST_RECIPIENT=

# Sales replies: the worker reads the SENDER_EMAIL mailbox over IMAP every 2 minutes (same app
# password as SMTP; Gmail needs IMAP enabled). Only replies to sales emails are kept.
# IMAP_SERVER=imap.gmail.com          # default: SMTP_SERVER with smtp. → imap.
# IMAP_PORT=993
# SALES_INBOX_SYNC=off                # turn reading replies off
# SALES_INBOX_INTERVAL_SECONDS=120
# Knowledge base embeddings run locally (model downloads once to .cache/models)
# KB_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
# KB_MODEL_CACHE=/path/to/models
# Web search for Rozee.pk job posts and company research (websites, emails, decision-makers).
# Free key (2,500 searches) at https://serper.dev. Without it a free search engine is used, which
# stops after a few searches. Rozee.pk itself blocks automated browsers, so it is searched this way.
# SERPER_API_KEY=
# HUNTER_API_KEY=   # optional: email addresses by company domain (hunter.io)
