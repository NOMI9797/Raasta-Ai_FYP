# Copy to .env.local and fill in values. See docs/ai-hiring/15-env-deployment.md.
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ─── Database / cache ───
DATABASE_URL=
DATABASE_SSL=
REDIS_URL=

# ─── LLM (Groq) ───
GROQ_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=

# ─── App URLs ───
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_INTERVIEW_WS_URL=

# ─── Interview engine ───
INTERVIEW_TICKET_SECRET=
INTERVIEW_ENGINE_PORT=
INTERVIEW_MAX_SESSIONS=
INTERVIEW_SILENCE_MS=
INTERVIEWER_NAME=
TTS_VOICE=
DEEPGRAM_API_KEY=

# ─── AI engine (Python) ───
AI_ENGINE_URL=
AI_ENGINE_TOKEN=
MODEL_CACHE_DIR=
FACE_ANALYSIS_ENABLED=

# ─── Storage (resumes, recordings) ───
STORAGE_DRIVER=
STORAGE_LOCAL_DIR=
STORAGE_SIGNING_SECRET=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Hiring worker ───
HIRING_WORKER_CONCURRENCY=
WORKER_ID=

# ─── Email ───
MAILGUN_API_KEY=
